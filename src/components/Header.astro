---
const { pathname } = Astro.url;
---
<header class="bg-white border-b border-slate-200 py-6 px-8">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-x-2">
      <div class="w-8 h-8 bg-slate-600 rounded-full"></div>
      <h1>傑尼安</h1>
    </div>

    <nav>
      <ul class="grid grid-cols-2 text-slate-500 gap-x-4">
        <li>
          <a href="/" class={pathname === '/' ? 'text-slate-900 font-medium' : ''}>Home</a>
        </li>
        <li>
          <a href="/blog" class={pathname.startsWith('/blog') ? 'text-slate-900 font-medium' : ''}>Blog</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
