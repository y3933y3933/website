---
import "../styles/global.css";
import Header from "../components/Header.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>傑尼安</title>
  </head>
  <body class="bg-bg h-full">
    <div class="max-w-270 mx-auto py-8">
      <div
        class="bg-[#fafafa] rounded-2xl shadow-sm flex flex-col min-h-[calc(100vh-4rem)] overflow-clip"
      >
        <Header />
        <main class="flex-1 py-6 px-8">
          <slot />
        </main>
        <footer class="border-t border-slate-200 py-4 px-8">
          &copy; 2026 Joanne Lin
        </footer>
      </div>
    </div>
  </body>
</html>

<style>
  html {
    height: 100%;
  }
</style>

