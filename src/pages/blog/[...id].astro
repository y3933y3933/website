---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import H2 from "../../components/typography/H2.astro";
import Paragraph from "../../components/typography/Paragraph.astro";
import InlineCode from "../../components/typography/InlineCode.astro";
import ExternalLink from "../../components/typography/ExternalLink.astro";
import Ul from "../../components/typography/Ul.astro";
import Li from "../../components/typography/Li.astro";
import Thread from "../../components/shareButtons/Thread.astro";
import Linkedin from "../../components/shareButtons/Linkedin.astro";
import ShareButton from "../../components/shareButtons/ShareButton.astro";
import TableOfContents from "../../components/TableOfContents";
import { formatDate } from "../../helper/date";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout>
  <h1 class="text-4xl font-semibold tracking-tight">{post.data.title}</h1>
  <p class="text-slate-500 text-sm flex gap-x-2 mt-3">
    <time>{formatDate(post.data.pubDate)}</time>
    <span>•</span>
    {post.data.tags.map((tag) => <a href="/tags">#{tag}</a>)}
  </p>
  <div class="flex gap-8 mt-4">
    <article class="flex-1 min-w-0">
      <Content
        components={{
          h2: H2,
          p: Paragraph,
          code: InlineCode,
          a: ExternalLink,
          ul: Ul,
          li: Li,
        }}
      />
      <div class="border-border mt-8 border-t pt-8"></div>
      <div class="flex items-center gap-x-3 mb-3">
        <span class="text-sm text-muted-foreground">Share</span>
        <Thread url={Astro.url.href} title={post.data.title} />
        <Linkedin url={Astro.url.href} />
        <ShareButton url={Astro.url.href} title={post.data.title} />
      </div>
    </article>
    <aside class="hidden lg:block w-56 shrink-0">
      <div class="sticky top-24">
        <TableOfContents client:load />
      </div>
    </aside>
  </div>
</Layout>
