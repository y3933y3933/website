---
import { formatDate } from "../../helper/date";
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allBlogPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout>
  <div class="mb-8">
    <h1 class="text-2xl font-semibold">文章列表</h1>
    <p class="text-muted-foreground mt-3">
      我是一名軟體工程師，在這裡記錄想法、學習筆記，以及正在探索的各種事物。
    </p>
  </div>
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_250px]">
    {
      allBlogPosts.map((post) => (
        <a
          class="block rounded-lg bg-white px-5 py-4 shadow-xs transition-colors hover:bg-white/50 border-border "
          href={`/blog/${post.id}`}
        >
          <div class="text-muted-foreground text-sm flex gap-x-2 mb-1">
            <time>{formatDate(post.data.pubDate)}</time>
            <span>•</span>
            {post.data.tags.map((tag) => (
              <span>#{tag}</span>
            ))}
          </div>

          <h3 class="text-lg font-semibold mb-2">{post.data.title}</h3>
          <p class="text-muted-foreground">{post.data.description}</p>
        </a>
      ))
    }
  </div>
</Layout>
