---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import avatar from "../assets/avatar.avif";

const workExperience = [
  {
    company: "Photon Future",
    title: "Backend Engineer",
    period: "2025/08 — Present",
  },
  {
    company: "OneClass",
    title: "Senior Frontend Engineer",
    period: "2023/11 — 2024/10",
  },
  {
    company: "Duotify",
    title: "Frontend Engineer",
    period: "2020/08 — 2023/10",
  },
];
---

<Layout
  title="Home"
  description="傑尼安的個人網站。曾任前端工程師，現為 Golang 後端工程師，兼職寶可夢訓練師。分享技術文章與開發心得。"
>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-x-4 items-center">
    <section class="py-12 md:col-span-2">
      <p
        class="text-sm font-medium text-muted-foreground uppercase tracking-widest mb-3"
      >
        Backend Engineer
      </p>
      <h1 class="text-4xl font-bold text-heading leading-tight mb-4">傑尼安</h1>
      <p class="text-body text-lg leading-relaxed mb-8">
        曾當過 4 年的前端工程師，現職為 Golang 後端工程師，兼職寶可夢訓練師。
        在還沒有被 AI 浪潮打死之前苟延殘喘中。
      </p>
    </section>
    <Image src={avatar} alt="avatar" class="hidden md:block" />
  </div>

  <div class="flex items-center gap-4">
    <div class="h-px flex-1 bg-slate-200"></div>
    <h2
      class="text-muted-foreground text-xs font-medium tracking-widest uppercase"
    >
      工作經歷
    </h2>
    <div class="h-px flex-1 bg-slate-200"></div>
  </div>
  <div class="relative mt-8 ml-1.25 pl-7">
    <div class="absolute top-7.75 bottom-0 left-0 w-px bg-[#ddd]"></div>
    {
      workExperience.map((job, i) => (
        <div class={`relative mb-3`}>
          <div class="absolute top-6.25 -left-8.5 size-3 rounded-full bg-[#ffd9a3]" />
          <div class="border border-slate-200 flex flex-col rounded-lg bg-white px-5 py-4 shadow-xs md:flex-row md:items-baseline md:justify-between">
            <div>
              <div class="text-lg font-bold text-heading">{job.title}</div>
              <div class="text-muted-foreground text-sm">{job.company}</div>
            </div>
            <div class="text-muted-foreground mt-1 text-sm whitespace-nowrap md:mt-0">
              {job.period}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</Layout>
